# ==========================================
# PRODUCCIÓN - Variables de entorno
# Copia este archivo como .env y configura
# ==========================================

# Database (contraseña segura de 32+ caracteres)
DB_USER=catalogo
DB_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA_32_CHARS
DB_NAME=catalogo_db

# Redis (contraseña segura)
REDIS_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA_REDIS

# JWT (generar con: openssl rand -base64 64)
JWT_SECRET=CAMBIAR_POR_SECRET_SEGURO_64_CHARS
JWT_REFRESH_SECRET=CAMBIAR_POR_REFRESH_SECRET_SEGURO_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (tu dominio real)
FRONTEND_URL=https://tudominio.com
NEXT_PUBLIC_API_URL=https://tudominio.com/api/v1

# Cloudinary (obtener de dashboard.cloudinary.com)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
