      "name": "Es admin?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "content": "## Verificacion de admin\n\nSolo el numero configurado en la variable de entorno ADMIN_PHONE puede registrar productos.\nSi no es admin, se ignora el mensaje y se responde 200 OK al webhook.",
        "width": 320,
        "height": 130
      },
      "id": "sticky-admin",
      "name": "Nota Admin",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [650, 130]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
