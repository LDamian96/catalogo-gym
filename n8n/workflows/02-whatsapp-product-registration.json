              "value": "Envia una foto del producto con su nombre, precio y categoria.\n\nEjemplo: envia una imagen y escribe:\nCreatina Monohidrate 300g Optimum 89.90 Proteinas",
              "type": "string"
            },
            {
              "id": "no-image-phone",
              "name": "senderPhone",
              "value": "={{ $json.senderPhone }}",
              "type": "string"
            },
            {
              "id": "no-image-instance",
              "name": "instanceName",
              "value": "={{ $json.instanceName }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
