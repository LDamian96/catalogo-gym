      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [470, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-admin",
              "leftValue": "={{ $json.senderPhone }}",
              "rightValue": "={{ $env.ADMIN_PHONE }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
