              "value": "={{ $('Extraer datos del mensaje').item.json.instanceName }}",
              "type": "string"
            },
            {
              "id": "success-cloudinary",
              "name": "cloudinaryUrl",
              "value": "={{ $('Combinar datos + Cloudinary URL').item.json.cloudinaryUrl }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "success-data",
      "name": "Datos de exito",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [3410, 100]
    },
    {
      "parameters": {
        "amount": "={{ Math.floor(Math.random() * 121) + 180 }}",
        "unit": "seconds"
      },
      "id": "wait-natural-delay",
      "name": "Espera 3-5 min (natural)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [3630, 100]
    },
    {
      "parameters": {
        "content": "## Delay natural\n\nEspera entre 3 y 5 minutos antes de enviar la confirmacion.\nEsto hace que las respuestas se sientan mas naturales y no como un bot automatizado.",
        "width": 310,
        "height": 120
      },
      "id": "sticky-delay",
      "name": "Nota Delay",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [3590, -40]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $json.instanceName || $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.senderPhone }}@s.whatsapp.net\",\n  \"text\": \"Producto creado: {{ $json.productName }} - S/{{ $json.productPrice }} \\u2705\\n\\n{{ $json.cloudinaryUrl }}\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "send-success-whatsapp",
      "name": "Enviar confirmacion al admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3850, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'ok' }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "webhook-response-ok",
      "name": "Responder OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [4070, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
