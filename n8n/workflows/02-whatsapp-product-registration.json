      "name": "Responder OK (no image)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1610, 480]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/chat/getBase64FromMediaMessage/{{ $json.instanceName || $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": {\n    \"key\": {{ $json.messageKey }}\n  }\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "download-image",
      "name": "Descargar imagen de Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 200]
    },
    {
      "parameters": {
        "content": "## Descarga de imagen\n\nSe usa el endpoint POST /chat/getBase64FromMediaMessage de Evolution API.\nRetorna la imagen en base64 que luego se sube a Cloudinary.",
        "width": 320,
        "height": 120
      },
      "id": "sticky-download",
      "name": "Nota Descarga",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1100, 50]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analiza el siguiente texto enviado por un administrador para crear un producto en el catalogo. Extrae la informacion en formato JSON.\n\nTexto del admin:\n\"{{ $('Extraer datos del mensaje').item.json.messageText }}\"\n\nEl admin puede escribir de forma casual, como:\n- \"creatina monohidrate 300g optimum 89.90 proteinas\"\n- \"whey protein gold 2lb ON 189.90 proteinas\"\n- \"BCAA 400g Universal 59.90\"\n- \"guantes nike talla M 45.90 accesorios\"\n\nResponde UNICAMENTE con un JSON valido (sin markdown, sin explicacion) con estos campos:\n{\n  \"name\": \"nombre completo del producto con gramos/unidad si aplica\",\n  \"price\": numero (precio en soles, sin simbolo S/),\n  \"salePrice\": numero o null (precio de oferta si lo menciona),\n  \"description\": \"descripcion breve del producto (maximo 200 caracteres, generala tu basandote en el nombre)\",\n  \"categoryName\": \"nombre de la categoria (ej: Proteinas, Creatinas, Pre-entreno, Aminoacidos, Accesorios, Vitaminas)\",\n  \"stock\": numero o null\n}\n\nSi el texto no tiene precio, usa 0.\nSi no menciona categoria, infiere una razonable basada en el tipo de producto.\nSi no tiene descripcion detallada, genera una breve y atractiva basada en el nombre del producto.",
        "options": {
          "systemMessage": "Eres un asistente experto en suplementos deportivos que extrae datos de productos para un catalogo online. Siempre respondes SOLO con JSON valido, sin texto adicional ni formato markdown. Eres muy bueno interpretando mensajes casuales y abreviados."
        }
      },
      "id": "ai-extract-product",
      "name": "IA - Extraer datos producto",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [1400, 200]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.2,
          "maxTokens": 500
        }
      },
      "id": "openai-model-extract",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [1400, 420],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const aiOutput = $input.first().json.output || $input.first().json.text || '{}';\n\ntry {\n  // Limpiar posible markdown del output\n  let cleaned = aiOutput.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  const productData = JSON.parse(cleaned);\n  \n  // Obtener base64 de la imagen descargada\n  const imageResponse = $('Descargar imagen de Evolution').first().json;\n  const imageBase64 = imageResponse.base64 || imageResponse.data || '';\n  const imageMimetype = $('Extraer datos del mensaje').first().json.imageMimetype || 'image/jpeg';\n  \n  return [{\n    json: {\n      name: productData.name || 'Producto sin nombre',\n      price: parseFloat(productData.price) || 0,\n      salePrice: productData.salePrice ? parseFloat(productData.salePrice) : null,\n      description: productData.description || '',\n      categoryName: productData.categoryName || 'General',\n      stock: productData.stock ? parseInt(productData.stock) : null,\n      imageBase64: imageBase64,\n      imageMimetype: imageMimetype,\n      senderPhone: $('Extraer datos del mensaje').first().json.senderPhone,\n      instanceName: $('Extraer datos del mensaje').first().json.instanceName\n    }\n  }];\n} catch (e) {\n  return [{\n    json: {\n      error: true,\n      errorMessage: 'No pude interpretar los datos del producto: ' + e.message,\n      senderPhone: $('Extraer datos del mensaje').first().json.senderPhone,\n      instanceName: $('Extraer datos del mensaje').first().json.instanceName\n    }\n  }];\n}"
      },
      "id": "parse-product-data",
      "name": "Parsear datos del producto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1630, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "no-error",
              "leftValue": "={{ $json.error }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notTrue"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-parse-error",
      "name": "Parse exitoso?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1860, 200]
    },
    {
      "parameters": {
        "content": "## Upload a Cloudinary\n\nSube la imagen en base64 a Cloudinary usando la REST API.\nSe usa upload_preset o api_key + api_secret.\nRetorna la URL segura de la imagen subida.",
        "width": 320,
        "height": 130
      },
      "id": "sticky-cloudinary",
      "name": "Nota Cloudinary",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [2040, -30]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.cloudinary.com/v1_1/{{ $env.CLOUDINARY_CLOUD_NAME }}/image/upload",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"file\": \"data:{{ $json.imageMimetype }};base64,{{ $json.imageBase64 }}\",\n  \"api_key\": \"{{ $env.CLOUDINARY_API_KEY }}\",\n  \"api_secret\": \"{{ $env.CLOUDINARY_API_SECRET }}\",\n  \"folder\": \"catalogo/productos\",\n  \"upload_preset\": \"{{ $env.CLOUDINARY_UPLOAD_PRESET || 'ml_default' }}\"\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "upload-cloudinary",
      "name": "Subir imagen a Cloudinary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2090, 100]
    },
    {
      "parameters": {
        "jsCode": "const cloudinaryResponse = $input.first().json;\nconst productData = $('Parsear datos del producto').first().json;\n\nreturn [{\n  json: {\n    ...productData,\n    cloudinaryUrl: cloudinaryResponse.secure_url || cloudinaryResponse.url || '',\n    cloudinaryPublicId: cloudinaryResponse.public_id || ''\n  }\n}];"
      },
      "id": "merge-cloudinary-data",
      "name": "Combinar datos + Cloudinary URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2310, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CATALOG_API_URL || 'http://cat_backend:3000/api/v1' }}/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"email\": \"{{ $env.CATALOG_ADMIN_EMAIL || 'admin@catalogo.com' }}\",\n  \"password\": \"{{ $env.CATALOG_ADMIN_PASSWORD || 'password' }}\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "auth-login",
      "name": "Login API Catalogo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2530, 100]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CATALOG_API_URL || 'http://cat_backend:3000/api/v1' }}/categories",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.accessToken || $json.tokens?.accessToken }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "get-categories",
      "name": "GET Categorias",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2750, 100]
    },
    {
      "parameters": {
        "content": "## Autenticacion y creacion\n\n1. Login con credenciales de admin al API del catalogo\n2. Obtiene lista de categorias para mapear nombre -> ID\n3. Crea el producto con POST /products incluyendo la URL de Cloudinary\n4. Responde al admin con confirmacion",
        "width": 380,
        "height": 140
      },
      "id": "sticky-create",
      "name": "Nota Creacion",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [2490, -60]
    },
    {
      "parameters": {
        "jsCode": "const categories = $input.first().json.data || $input.first().json || [];\nconst productData = $('Combinar datos + Cloudinary URL').first().json;\nconst authData = $('Login API Catalogo').first().json;\n\n// Buscar categoria por nombre (case insensitive, parcial)\nlet categoryId = null;\nconst catList = Array.isArray(categories) ? categories : (categories.data || []);\n\nfor (const cat of catList) {\n  if (cat.name && productData.categoryName) {\n    const catNameLower = cat.name.toLowerCase();\n    const searchNameLower = productData.categoryName.toLowerCase();\n    if (catNameLower.includes(searchNameLower) || searchNameLower.includes(catNameLower)) {\n      categoryId = cat.id;\n      break;\n    }\n  }\n}\n\n// Si no encontro match, usar la primera categoria disponible\nif (!categoryId && catList.length > 0) {\n  categoryId = catList[0].id;\n}\n\nreturn [{\n  json: {\n    ...productData,\n    categoryId: categoryId,\n    accessToken: authData.accessToken || authData.tokens?.accessToken\n  }\n}];"
      },
      "id": "map-category",
      "name": "Mapear categoria",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2970, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CATALOG_API_URL || 'http://cat_backend:3000/api/v1' }}/products",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.accessToken }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": {{ JSON.stringify($json.name) }},\n  \"categoryId\": \"{{ $json.categoryId }}\",\n  \"price\": {{ $json.price }},\n  \"salePrice\": {{ $json.salePrice || 'null' }},\n  \"description\": {{ JSON.stringify($json.description || '') }},\n  \"stock\": {{ $json.stock || 'null' }},\n  \"isActive\": true,\n  \"showPrice\": true,\n  \"images\": [\"{{ $json.cloudinaryUrl }}\"]\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "create-product",
      "name": "Crear producto en API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3190, 100]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "success-data",
              "name": "productName",
              "value": "={{ $json.name }}",
              "type": "string"
            },
            {
              "id": "success-price",
              "name": "productPrice",
              "value": "={{ $json.price }}",
              "type": "number"
            },
            {
              "id": "success-id",
