              "name": "result",
              "value": "No hay productos con stock bajo. Sin alertas.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "log-no-alert",
      "name": "Sin alertas",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1790, 420]
    },
    {
      "parameters": {
