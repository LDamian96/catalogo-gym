    {
      "parameters": {
        "content": "## MODO 2: Cron Auto-detect\n\nDiariamente a las 8am:\n1. Login al API\n2. Obtener todos los productos\n3. Filtrar los que no tienen seoTitle\n4. Si hay productos sin SEO -> notificar al admin por WhatsApp\n5. El admin puede responder \"seo todos\" para procesarlos (se maneja en Modo 1)",
        "width": 450,
        "height": 180
      },
      "id": "sticky-cron",
      "name": "Nota Cron",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [200, 750]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CATALOG_API_URL || 'http://cat_backend:3000/api/v1' }}/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"email\": \"{{ $env.CATALOG_ADMIN_EMAIL || 'admin@catalogo.com' }}\",\n  \"password\": \"{{ $env.CATALOG_ADMIN_PASSWORD || 'password' }}\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "cron-login",
      "name": "Login API (cron)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [490, 900]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CATALOG_API_URL || 'http://cat_backend:3000/api/v1' }}/products?limit=200",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.accessToken || $json.tokens?.accessToken }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "cron-get-products",
      "name": "GET Todos los Productos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 900]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst products = response.data || response.items || response || [];\nconst productList = Array.isArray(products) ? products : [];\n\n// Filtrar productos sin seoTitle\nconst needsSeo = productList.filter(p => !p.seoTitle || p.seoTitle === '' || p.seoTitle === null);\n\nreturn [{\n  json: {\n    totalProducts: productList.length,\n    productsWithoutSeo: needsSeo.length,\n    hasProductsWithoutSeo: needsSeo.length > 0,\n    productNames: needsSeo.slice(0, 10).map(p => p.name).join(', ')\n  }\n}];"
      },
      "id": "cron-filter-no-seo",
      "name": "Filtrar productos sin SEO",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [950, 900]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-products-without-seo",
              "leftValue": "={{ $json.hasProductsWithoutSeo }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "cron-check-has-products",
      "name": "Hay productos sin SEO?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1180, 900]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $env.ADMIN_PHONE }}@s.whatsapp.net\",\n  \"text\": \"\\ud83d\\udd0d *Reporte SEO diario*\\n\\nHay {{ $json.productsWithoutSeo }} producto(s) sin SEO configurado.\\n\\nAlgunos de ellos:\\n{{ $json.productNames }}\\n\\n\\u00bfQuieres que les genere sugerencias? Responde *'seo todos'* para procesarlos.\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "cron-notify-admin",
      "name": "Notificar admin por WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1420, 840]
