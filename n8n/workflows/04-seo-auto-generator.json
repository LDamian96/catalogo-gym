      },
      "id": "sticky-delay",
      "name": "Nota Delay",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $json.instanceName || $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
