              "value": "={{ $('Extraer datos WhatsApp').item.json.instanceName }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "prepare-agent-response",
      "name": "Preparar respuesta agente",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1220, 400]
    },
    {
      "parameters": {
        "amount": "={{ Math.floor(Math.random() * 121) + 180 }}",
