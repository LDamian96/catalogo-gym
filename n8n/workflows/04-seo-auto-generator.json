      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1450, 400]
    },
    {
      "parameters": {
        "content": "## Delay natural\n\nEspera entre 3 y 5 minutos para que la respuesta se sienta humana y no automatizada.",
        "width": 280,
