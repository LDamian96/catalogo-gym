              "type": "string"
            },
            {
              "id": "agent-phone",
              "name": "senderPhone",
              "value": "={{ $('Extraer datos WhatsApp').item.json.senderPhone }}",
              "type": "string"
            },
            {
              "id": "agent-instance",
