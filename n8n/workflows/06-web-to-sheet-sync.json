      "id": "http-get-products",
      "name": "HTTP - Obtener Todos los Productos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 920]
    },
    {
      "parameters": {
        "jsCode": "// Transformar productos del API al formato del Sheet\nconst response = $input.all();\nconst items = [];\n\nfor (const entry of response) {\n  const data = entry.json.data || entry.json;\n  const products = Array.isArray(data) ? data : (data.data || []);\n  \n  for (const p of products) {\n    items.push({\n      json: {\n        id: p.id,\n        nombre: p.name,\n        precio: Number(p.price),\n        precioOferta: p.salePrice ? Number(p.salePrice) : '',\n        categoria: p.category?.name || '',\n        marca: p.brand?.name || '',\n        descripcion: p.description || '',\n        stock: p.stock ?? '',\n        estado: p.isActive ? 'Activo' : 'Inactivo',\n        seoTitulo: p.seoTitle || '',\n        seoDescripcion: p.seoDescription || '',\n        seoKeywords: p.seoKeywords || '',\n        urlImagen: p.images?.[0]?.url || ''\n      }\n    });\n  }\n}\n\nreturn items;"
      },
      "id": "transform-products",
      "name": "Transformar Productos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 920]
    },
